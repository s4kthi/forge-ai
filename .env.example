# Replace the placeholder in both lines with the same URL-safe local password.
POSTGRES_PASSWORD=replace_me
DATABASE_URL=postgresql://forge_ai:replace_me@127.0.0.1:5432/forge_ai

API_PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
NODE_ENV=development
# Optional; only honored in development and test, and still requires an owner/admin session.
ENABLE_DEMO_FIXTURES=false

# Backend-only Gemini settings. Set the key in the ignored .env file.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=

# Optional GitHub App integration. Use an absolute path to a PEM kept outside this checkout.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
# JSON map: GitHub installation ID -> Forge organization UUID. Managed by a server operator.
GITHUB_INSTALLATION_BINDINGS={}
