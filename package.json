{
  "name": "forge-ai",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": "^22.12.0 || >=24.0.0" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently --kill-others --names api,web \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace @forge-ai/api",
    "dev:web": "npm run dev --workspace @forge-ai/web",
    "dev:worker": "npm run dev:worker --workspace @forge-ai/api",
    "start:worker": "npm run start:worker --workspace @forge-ai/api",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "db:generate": "npm run db:generate --workspace @forge-ai/api",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace @forge-ai/api",
    "db:migrate:dev": "npm run db:migrate:dev --workspace @forge-ai/api --",
    "db:seed": "npm run db:seed --workspace @forge-ai/api",
    "db:claim-demo": "npm run db:claim-demo --workspace @forge-ai/api --",
    "test": "npm test --workspace @forge-ai/api",
    "test:web": "npm test --workspace @forge-ai/web",
    "db:validate": "npm run db:validate --workspace @forge-ai/api",
    "db:up": "docker compose --env-file .env -f infrastructure/compose.yaml up -d --wait",
    "db:down": "docker compose --env-file .env -f infrastructure/compose.yaml down"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
