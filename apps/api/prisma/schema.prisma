generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  email         String               @unique
  passwordHash  String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  memberships   OrganizationMember[]
  assignedTasks Task[]
  sessions      Session[]
  ownedTickets  Ticket[]
}

model Session {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime  @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Organization {
  id        String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String               @unique
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  demoClaimedAt DateTime? @db.Timestamptz(3)
  members   OrganizationMember[]
  projects  Project[]
  githubInstallations GitHubInstallation[]
  workers AgentWorker[]
}

model OrganizationMember {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String           @db.Uuid
  organizationId String           @db.Uuid
  role           OrganizationRole
  createdAt      DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Project {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String        @db.Uuid
  name           String
  description    String?
  status         ProjectStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tasks          Task[]
  githubRepositoryId String? @db.Uuid
  githubRepository GitHubRepository? @relation(fields: [organizationId, githubRepositoryId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  tickets Ticket[]

  @@index([organizationId, createdAt, id])
}

model Task {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String       @db.Uuid
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  assigneeId  String?      @db.Uuid
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)
  assignee    User?        @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  runs        AgentRun[]
  assignments WorkAssignment[]

  @@index([projectId, createdAt, id])
  @@index([assigneeId])
}

enum AgentRole {
  ALEX
  MARCUS
  DEVON
  TESSA
  ELENA
}

enum AgentRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AgentStepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum AgentMessageType {
  INSTRUCTION
  RESULT
  QUESTION
  HANDOFF
}

enum RunEventType {
  RUN_CREATED
  RUN_STARTED
  RUN_COMPLETED
  RUN_FAILED
  RUN_CANCELLED
  STEP_CREATED
  STEP_STARTED
  STEP_COMPLETED
  STEP_FAILED
  STEP_SKIPPED
  MESSAGE_RECORDED
  HANDOFF_RECORDED
  LLM_CALL_STARTED
  LLM_CALL_FINISHED
  RUN_RECOVERED
  REPOSITORY_OBSERVED
}

model AgentRun {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  taskId       String         @db.Uuid
  status       AgentRunStatus @default(PENDING)
  mode         AgentRunMode?
  isFixture    Boolean        @default(false)
  createdAt    DateTime       @default(now()) @db.Timestamptz(3)
  startedAt    DateTime?      @db.Timestamptz(3)
  completedAt  DateTime?      @db.Timestamptz(3)
  errorMessage String?
  task         Task           @relation(fields: [taskId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  steps        AgentStep[]
  messages     AgentMessage[]
  events       RunEvent[]
  llmCalls     LlmInvocation[]
  planningJob  PlanningJob?

  // PostgreSQL migration also defines a partial unique index for active runs.
  @@index([taskId, createdAt, id])
}

model PlanningJob {
  runId             String    @id @db.Uuid
  userId            String    @db.Uuid
  organizationId    String    @db.Uuid
  taskId            String    @db.Uuid
  keyHash           String?   @db.VarChar(64)
  context           Json?
  queuedAt          DateTime  @default(now()) @db.Timestamptz(3)
  leaseToken        String?   @db.Uuid
  leaseExpiresAt    DateTime? @db.Timestamptz(3)
  lastHeartbeatAt   DateTime? @db.Timestamptz(3)
  recoveryCount     Int       @default(0)
  attentionRequired Boolean   @default(false)
  run               AgentRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId, taskId, keyHash], map: "PlanningJob_request_key")
  @@index([leaseExpiresAt, queuedAt])
}

model AgentStep {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId        String          @db.Uuid
  agentRole    AgentRole
  status       AgentStepStatus @default(PENDING)
  sequence     Int
  input        Json?
  output       Json?
  startedAt    DateTime?       @db.Timestamptz(3)
  completedAt  DateTime?       @db.Timestamptz(3)
  errorMessage String?
  run          AgentRun        @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  messages     AgentMessage[]
  events       RunEvent[]
  llmCalls     LlmInvocation[]

  @@unique([runId, id])
  @@unique([runId, sequence])
}

model AgentMessage {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId       String           @db.Uuid
  stepId      String?          @db.Uuid
  fromAgent   AgentRole
  toAgent     AgentRole?
  messageType AgentMessageType
  content     String
  createdAt   DateTime         @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  run         AgentRun         @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  step        AgentStep?       @relation(fields: [runId, stepId], references: [runId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([runId, createdAt, id])
  @@index([runId, stepId])
}

model RunEvent {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId     String       @db.Uuid
  stepId    String?      @db.Uuid
  eventType RunEventType
  payload   Json
  sequence  Int
  createdAt DateTime     @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  run       AgentRun     @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  step      AgentStep?   @relation(fields: [runId, stepId], references: [runId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([runId, sequence])
  @@index([runId, stepId])
}

enum AgentRunMode {
  ALEX_SINGLE_AGENT
  ALEX_MARCUS
}

enum LlmInvocationStatus {
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  UNKNOWN
}

enum LlmErrorCategory {
  NOT_CONFIGURED
  AUTHENTICATION
  MODEL_UNAVAILABLE
  PROVIDER_REJECTED
  PROVIDER_UNAVAILABLE
  RATE_LIMIT
  TIMEOUT
  INVALID_OUTPUT
  CANCELLED
}

model LlmInvocation {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId             String              @db.Uuid
  stepId            String              @db.Uuid
  provider          String              @db.VarChar(32)
  model             String              @db.VarChar(128)
  modelVersion      String?             @db.VarChar(128)
  promptVersion     String              @db.VarChar(64)
  status            LlmInvocationStatus @default(RUNNING)
  startedAt         DateTime            @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  completedAt       DateTime?           @db.Timestamptz(3)
  latencyMs         Int?
  inputTokens       Int?
  outputTokens      Int?
  providerRequestId String?             @db.VarChar(256)
  errorCategory     LlmErrorCategory?
  estimatedCostUsd  Decimal?            @db.Decimal(12, 6)
  run               AgentRun            @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  step              AgentStep           @relation(fields: [runId, stepId], references: [runId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([runId, startedAt, id])
  @@index([runId, stepId])
}

model GitHubInstallation {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  githubId       String @unique @db.VarChar(20)
  account        String
  revokedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  repositories   GitHubRepository[]

  @@unique([organizationId, id])
}

model GitHubRepository {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  installationId String @db.Uuid
  githubId       String @db.VarChar(20)
  fullName       String
  defaultBranch  String?
  private        Boolean
  installation   GitHubInstallation @relation(fields: [organizationId, installationId], references: [organizationId, id], onDelete: Restrict)
  projects       Project[]

  @@unique([organizationId, id])
  @@unique([installationId, githubId])
}

enum WorkforceRole {
  PM
  ARCHITECT
  DESIGNER
  DEVELOPER
  QA
  REVIEWER
}

enum WorkStatus {
  TODO
  RUNNING
  BLOCKED
  COMPLETED
  FAILED
  CANCELLED
}

enum WorkflowEventKind {
  TICKET_CREATED
  TICKET_UPDATED
  ASSIGNED
  STATUS_CHANGED
  DEPENDENCY_ADDED
  HANDOFF
}

model AgentWorker {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  name           String
  role           WorkforceRole
  configuration  Json
  enabled        Boolean @default(true)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignments    WorkAssignment[]

  @@index([organizationId])
}

model Ticket {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId   String @db.Uuid
  requirement String
  priority    TaskPriority @default(MEDIUM)
  status      WorkStatus @default(TODO)
  ownerId     String @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  project     Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  owner       User @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  assignments WorkAssignment[]
  events      WorkflowEvent[]

  @@index([projectId, createdAt])
}

model WorkAssignment {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId       String @db.Uuid
  workerId       String @db.Uuid
  taskId         String? @db.Uuid
  status         WorkStatus @default(TODO)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  startedAt      DateTime? @db.Timestamptz(3)
  completedAt    DateTime? @db.Timestamptz(3)
  blockedReason  String?
  error          String?
  ticket         Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  worker         AgentWorker @relation(fields: [workerId], references: [id], onDelete: Restrict)
  task           Task? @relation(fields: [taskId], references: [id], onDelete: Restrict)
  outgoing       WorkflowDependency[] @relation("WorkflowFrom")
  incoming       WorkflowDependency[] @relation("WorkflowTo")
  events         WorkflowEvent[]

  @@unique([ticketId, id])
  @@index([workerId])
  @@index([taskId])
}

model WorkflowDependency {
  ticketId String @db.Uuid
  fromId   String @db.Uuid
  toId     String @db.Uuid
  from     WorkAssignment @relation("WorkflowFrom", fields: [ticketId, fromId], references: [ticketId, id], onDelete: Restrict)
  to       WorkAssignment @relation("WorkflowTo", fields: [ticketId, toId], references: [ticketId, id], onDelete: Restrict)

  @@id([ticketId, fromId, toId])
  @@index([ticketId, toId])
}

model WorkflowEvent {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticketId     String @db.Uuid
  assignmentId String? @db.Uuid
  actorId      String @db.Uuid
  kind         WorkflowEventKind
  payload      Json
  createdAt    DateTime @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  ticket       Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  assignment   WorkAssignment? @relation(fields: [ticketId, assignmentId], references: [ticketId, id], onDelete: Restrict)

  @@index([ticketId, createdAt, id])
}
